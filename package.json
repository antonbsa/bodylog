{
  "name": "bodylog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace @bodylog/api run dev",
    "dev:web": "npm --workspace @bodylog/web run dev --",
    "build": "npm run build:web",
    "build:web": "npm --workspace @bodylog/web run build",
    "lint": "eslint .",
    "deploy": "npm run deploy:api",
    "deploy:api": "npm --workspace @bodylog/api run deploy",
    "db:migrate:local": "wrangler d1 migrations apply body_metrics_tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply body_metrics_tracker --remote",
    "db:query:local": "wrangler d1 execute body_metrics_tracker --local --command",
    "db:query:remote": "wrangler d1 execute body_metrics_tracker --remote --command",
    "test": "npm run test:api",
    "test:api": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck:api && npm run typecheck:web && npm run typecheck:tests && npm run typecheck:e2e",
    "typecheck:api": "npm --workspace @bodylog/api run typecheck",
    "typecheck:web": "npm --workspace @bodylog/web run typecheck",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@playwright/test": "^1.53.0",
    "@rocketseat/eslint-config": "^2.2.2",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "wrangler": "^4.15.2"
  }
}
