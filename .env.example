# Cloudflare API token used by Wrangler for non-interactive deploys.
# Create it from Cloudflare Dashboard > My Profile > API Tokens.
CLOUDFLARE_API_TOKEN=

# Single-user height used by the API for BMI calculations, in centimeters.
USER_HEIGHT_CM=180

# Single-user authentication values for local development.
# Configure these as Cloudflare Worker secrets in production.
APP_PASSWORD="masterpass"

# Single-user session secret for encrypting session tokens.
SESSION_SECRET="random-session-secret"

# Optional API base URL used by the Vite frontend.
# Leave empty when the frontend and API share an origin or tests mock API calls.
VITE_API_BASE_URL=
